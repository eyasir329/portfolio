# Copy to .env.local. Everything is optional: without Supabase the contact form falls back to email.

# Public URL of the site (used for metadata, sitemap and OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (staging project for previews, production project for production — DEV-03 §1)
# Local values are printed by `pnpm exec supabase start`.
NEXT_PUBLIC_SUPABASE_URL=
# Server-only secret key. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Salt for hashing client IPs in the contact-form rate limit (random, at least 16 characters)
CONTACT_IP_SALT=

# Tests only: read Codeforces data from recorded fixtures instead of the network
# CODEFORCES_FIXTURE=tests/fixtures/codeforces
